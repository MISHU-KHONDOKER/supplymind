# ==============================================================================
# SupplyMind Environment Configuration
# ==============================================================================
# Copy this file to `.env` and fill in your values.
# Never commit `.env` to version control — it contains secrets.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with real values
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------

# Application environment: development, staging, production
APP_ENV=development

# Application name (used in logs and metrics)
APP_NAME=supplymind

# Application version (auto-set by CI; override for local development)
APP_VERSION=0.1.0

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json (production) or console (development)
LOG_FORMAT=console

# ------------------------------------------------------------------------------
# API and Backend
# ------------------------------------------------------------------------------

# FastAPI host and port
API_HOST=0.0.0.0
API_PORT=8000

# Number of Uvicorn worker processes (production: 2-4 × CPU cores)
API_WORKERS=1

# CORS allowed origins (comma-separated)
# In production, set to specific domains. Never use * in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Request timeout in seconds
REQUEST_TIMEOUT=120

# Maximum request body size in MB (for document uploads)
MAX_REQUEST_SIZE_MB=10

# API key for authenticated endpoints (generate with: openssl rand -hex 32)
API_KEY=change-me-in-production-use-openssl-rand-hex-32

# JWT secret for token signing (generate with: openssl rand -hex 64)
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-64

# JWT token expiration in minutes
JWT_EXPIRY_MINUTES=60

# ------------------------------------------------------------------------------
# LLM and Model Configuration
# ------------------------------------------------------------------------------

# Primary LLM model identifier (Hugging Face Hub format: org/model-name)
# Smaller models (0.5B, 1.5B) run on CPU. Larger (7B+) need GPU.
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Fallback LLM model (used if primary fails or for cost optimization)
LLM_FALLBACK_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Model inference device: cpu, cuda, mps (Apple Silicon), auto
LLM_DEVICE=cpu

# Maximum tokens to generate per LLM call
LLM_MAX_TOKENS=1024

# Sampling temperature (0.0 = deterministic, 1.0 = creative)
# Lower for analytical agents (Critic, Analyst), higher for generative (Reporter).
LLM_TEMPERATURE=0.3

# Top-p nucleus sampling (1.0 = consider all tokens)
LLM_TOP_P=0.9

# Per-call timeout in seconds (LLM inference can stall)
LLM_TIMEOUT=60

# Maximum retries on LLM failure (with exponential backoff)
LLM_MAX_RETRIES=3

# Initial retry delay in seconds (doubles with each retry)
LLM_RETRY_DELAY=2

# Enable response caching (saves cost for repeated queries)
LLM_CACHE_ENABLED=true

# Cache TTL in seconds (1 hour default)
LLM_CACHE_TTL=3600

# ------------------------------------------------------------------------------
# Embedding Model (for RAG)
# ------------------------------------------------------------------------------

# Sentence-Transformers model for text embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Embedding device (usually same as LLM_DEVICE)
EMBEDDING_DEVICE=cpu

# Batch size for embedding generation (higher = faster, more memory)
EMBEDDING_BATCH_SIZE=32

# ------------------------------------------------------------------------------
# Vector Store and RAG
# ------------------------------------------------------------------------------

# ChromaDB persistence directory (relative to backend root)
CHROMA_PERSIST_DIR=./data/chroma

# Collection name for supply chain documents
CHROMA_COLLECTION_NAME=supplymind_knowledge

# Number of documents to retrieve per query (top-k)
RAG_TOP_K=5

# Minimum similarity score for retrieved documents (0.0 to 1.0)
# Documents below this threshold are filtered out.
RAG_MIN_SIMILARITY=0.3

# Document chunk size in characters for indexing
RAG_CHUNK_SIZE=1000

# Overlap between chunks in characters (preserves context across boundaries)
RAG_CHUNK_OVERLAP=200

# Enable hybrid search (dense + keyword)
RAG_HYBRID_SEARCH=true

# Weight of dense (semantic) score vs sparse (keyword) score
# 1.0 = pure semantic, 0.0 = pure keyword, 0.7 = hybrid favoring semantic
RAG_DENSE_WEIGHT=0.7

# Enable reranking after initial retrieval
RAG_RERANK_ENABLED=false

# Reranker model (used only if RAG_RERANK_ENABLED=true)
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Documents passed to LLM after reranking
RAG_RERANK_TOP_N=3

# ------------------------------------------------------------------------------
# Observability — Prometheus and Grafana
# ------------------------------------------------------------------------------

# Prometheus metrics server port (separate from API port)
PROMETHEUS_PORT=9090

# Prometheus scrape interval in seconds (how often metrics are collected)
PROMETHEUS_SCRAPE_INTERVAL=15

# Enable detailed per-agent metrics (slight overhead)
METRICS_PER_AGENT_ENABLED=true

# Enable token usage tracking per call (for cost monitoring)
METRICS_TOKEN_TRACKING=true

# Custom service label applied to all metrics
METRICS_SERVICE_LABEL=supplymind-backend

# ------------------------------------------------------------------------------
# Grafana
# ------------------------------------------------------------------------------

# Grafana port (UI access)
GRAFANA_PORT=3001

# Grafana admin credentials (change in production)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Auto-provision dashboards on startup
GRAFANA_AUTO_PROVISION=true

# ------------------------------------------------------------------------------
# Tracing (OpenTelemetry-compatible)
# ------------------------------------------------------------------------------

# Enable distributed tracing
TRACING_ENABLED=false

# OTLP exporter endpoint (Jaeger, Tempo, or compatible)
OTLP_ENDPOINT=http://localhost:4317

# Sampling rate (0.0 to 1.0). 1.0 = trace every request, 0.1 = 10%
TRACING_SAMPLE_RATE=1.0

# ------------------------------------------------------------------------------
# Structured Logging
# ------------------------------------------------------------------------------

# Include correlation ID in every log entry (recommended: true)
LOG_CORRELATION_ID=true

# Include agent name as a log field
LOG_INCLUDE_AGENT_NAME=true

# Log file destination (empty = stdout only, standard for containers)
LOG_FILE=

# Maximum log file size in MB before rotation
LOG_FILE_MAX_SIZE_MB=100

# Number of rotated log files to keep
LOG_FILE_BACKUP_COUNT=5

# ------------------------------------------------------------------------------
# Web Search Tool
# ------------------------------------------------------------------------------

# Tavily API key (optional — for live web search by Researcher agent)
# Get a free key at: https://tavily.com
TAVILY_API_KEY=

# Maximum search results per query
TAVILY_MAX_RESULTS=5

# Search depth: basic (faster, cheaper) or advanced (better quality)
TAVILY_SEARCH_DEPTH=basic

# Per-request timeout in seconds
TAVILY_TIMEOUT=30

# ------------------------------------------------------------------------------
# Anomaly Detection Engine
# ------------------------------------------------------------------------------

# Contamination ratio for Isolation Forest (expected anomaly fraction)
ANOMALY_CONTAMINATION=0.05

# Number of base estimators in the ensemble
ANOMALY_N_ESTIMATORS=100

# Random seed for reproducibility
ANOMALY_RANDOM_STATE=42

# Confidence threshold below which Analyst flags as uncertain (0.0 to 1.0)
ANOMALY_CONFIDENCE_THRESHOLD=0.7

# ------------------------------------------------------------------------------
# Circuit Breaker
# ------------------------------------------------------------------------------

# Number of consecutive failures before circuit opens
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Seconds to wait before allowing a test request (half-open state)
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# Number of successful test requests before fully closing the circuit
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2

# ------------------------------------------------------------------------------
# Evaluation Framework
# ------------------------------------------------------------------------------

# Run evaluation suite on application startup (for CI)
EVAL_ON_STARTUP=false

# Path to golden test set (JSON file)
EVAL_GOLDEN_SET_PATH=./tests/eval/golden_set.json

# Minimum task completion rate to consider build healthy (0.0 to 1.0)
EVAL_MIN_COMPLETION_RATE=0.85

# Maximum hallucination rate before build fails (0.0 to 1.0)
EVAL_MAX_HALLUCINATION_RATE=0.10

# Maximum p95 latency in seconds before build fails
EVAL_MAX_P95_LATENCY=10

# ------------------------------------------------------------------------------
# Data and Synthetic Generation
# ------------------------------------------------------------------------------

# Random seed for synthetic data generation (reproducibility)
SYNTHETIC_DATA_SEED=42

# Number of suppliers in synthetic dataset
SYNTHETIC_NUM_SUPPLIERS=50

# Number of products in synthetic dataset
SYNTHETIC_NUM_PRODUCTS=200

# Days of historical operational data to generate
SYNTHETIC_HISTORY_DAYS=90

# Injected anomaly rate (fraction of records that are anomalies)
SYNTHETIC_ANOMALY_RATE=0.03